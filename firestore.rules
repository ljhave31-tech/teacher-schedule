rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the three places the app uses, and only for signed-in (anonymous) app users.
    match /teachers/{id}    { allow read, write: if request.auth != null; }
    match /assignments/{id} { allow read, write: if request.auth != null; }
    match /hr/{id}          { allow read, write: if request.auth != null; }
    // everything else is closed
  }
}
